<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Navigatueur.App.Converters">

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#3A3B3F" />
    <SolidColorBrush x:Key="ChromeTextBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2D31" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />

    <converters:BoolToActiveBrushConverter x:Key="ActiveTabBackgroundConverter" />
    <converters:RamUsageToBrushConverter x:Key="RamUsageToBrushConverter" />
    <converters:PathToImageSourceConverter x:Key="PathToImageSourceConverter" />
    <converters:SiteAccentGradientConverter x:Key="SiteAccentGradientConverter" />

    <!--
      App-wide font. FontFamily/FontWeight are inherited WPF properties, so
      setting them once on every Window cascades to all of its descendants
      (buttons, text boxes, menus...) without needing per-control styles.
      Fallback chain covers machines without Cascadia Code installed.
    -->
    <!--
      "Cascadia Code SemiBold" is its own distinct installed font family (not a
      weight variant of "Cascadia Code") — also setting FontWeight="SemiBold" on
      top of it asks WPF to find a semi-bold FACE *within* that already-semi-bold
      family, which it can't satisfy, and it silently fell back past the whole
      list to Segoe UI instead of ever rendering as Cascadia Code at all. Naming
      the family directly, with no FontWeight override, renders reliably.
    -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Cascadia Code SemiBold, Consolas, Segoe UI" />
        <Setter Property="Cursor" Value="{DynamicResource AppCursor}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!--
                          Declared first (behind the content) so the icon/text never gets covered —
                          it used to render on top at full opacity, hiding the button's icon entirely
                          on hover. Separate fade-in/out overlay instead of animating ButtonBorder's own
                          Background directly — that background is often an arbitrary/DynamicResource
                          brush (transparent, accent...) set per-button, so animating its Color isn't
                          reliably possible. A dedicated overlay fades independently of whatever's underneath.
                        -->
                        <Border x:Name="HoverOverlay" Background="{DynamicResource ChromeBorderBrush}"
                                CornerRadius="4" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity"
                                                         To="0.35" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ChromeTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Implicit ContextMenu/MenuItem styles — without these, every right-click
      menu and the "..." toolbar menu render with WPF's default Win32-ish
      white popup, which clashes hard against the rest of the app's dark,
      rounded, Cascadia Code look. No x:Key, so this applies everywhere a
      ContextMenu/MenuItem is used without needing to touch each call site.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource ChromeBackgroundBrush}"
                            BorderBrush="{DynamicResource ChromeBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                                   VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0"
                                           Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource ChromeBackgroundBrush}"
                                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4" Margin="4,0,0,0">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource ChromeBorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
    </Style>

</ResourceDictionary>
