<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Navigatueur.App.Converters">

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#3A3B3F" />
    <SolidColorBrush x:Key="ChromeTextBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2D31" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />

    <converters:BoolToActiveBrushConverter x:Key="ActiveTabBackgroundConverter" />
    <converters:RamUsageToBrushConverter x:Key="RamUsageToBrushConverter" />
    <converters:PathToImageSourceConverter x:Key="PathToImageSourceConverter" />

    <!--
      App-wide font. FontFamily/FontWeight are inherited WPF properties, so
      setting them once on every Window cascades to all of its descendants
      (buttons, text boxes, menus...) without needing per-control styles.
      Fallback chain covers machines without Cascadia Code installed.
    -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Cascadia Code SemiBold, Cascadia Code, Consolas, Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ChromeBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ChromeTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
