    <Style x:Key="VectorIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <Style x:Key="MenuIcon" TargetType="Path" BasedOn="{StaticResource VectorIcon}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

</ResourceDictionary>
