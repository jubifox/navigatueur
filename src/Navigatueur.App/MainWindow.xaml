<Window x:Class="Navigatueur.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Navigatueur.App.Views"
        xmlns:models="clr-namespace:Navigatueur.App.Models"
        xmlns:vm="clr-namespace:Navigatueur.App.ViewModels"
        Title="Navigatueur"
        Background="{DynamicResource ChromeBackgroundBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        Height="800" Width="1280"
        PreviewMouseMove="OnWindowMouseMoveForTrail"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="CaptionIcon" TargetType="Path" BasedOn="{StaticResource VectorIcon}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="StrokeThickness" Value="1.6" />
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Chrome background image (if the user picked one) + a semi-transparent wash in the theme
             background color on top, so the toolbar/tab strip stay readable over any photo. -->
        <Image Source="{Binding Theme.ChromeBackgroundImagePath, Converter={StaticResource PathToImageSourceConverter}}"
               Stretch="UniformToFill" />
        <Border Background="{DynamicResource ChromeBackgroundBrush}" Opacity="0.55" />

        <!-- The current site's declared theme-color, faded top-to-gray — transparent (no-op) when
             the site doesn't declare one, or a custom background image is set. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <MultiBinding Converter="{StaticResource SiteAccentGradientConverter}">
                    <Binding Path="ActiveTab.SiteAccentColorHex" />
                    <Binding Path="Theme.ChromeBackgroundImagePath" />
                </MultiBinding>
            </Border.Background>
        </Border>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar, replacing the native white caption so it matches the app's own theme. -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="🧭" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Navigatueur" FontSize="12" Opacity="0.85"
                               Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Réduire">
                        <Path Data="{StaticResource IconMinimize}" Style="{StaticResource CaptionIcon}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick" ToolTip="Agrandir/Restaurer">
                        <Path Style="{StaticResource CaptionIcon}">
                            <Path.Data>
                                <Binding Path="WindowState" RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{StaticResource WindowStateToIconConverter}" />
                            </Path.Data>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnCloseClick" ToolTip="Fermer">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource CaptionIcon}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The address bar TextBox is a single shared instance moved between slot
             Borders at runtime (see ApplyAddressBarPosition) — Top/Sidebar slots now
             live in ToolbarWindow/TabSidebarWindow (separate windows), Bottom stays
             below. It needs *some* declared parent here since it's this XAML file's
             code-behind that owns its event handlers; Collapsed because it's always
             reparented immediately in the constructor, never actually shown here. -->
        <Border x:Name="AddressBarInitialHost" Visibility="Collapsed">
            <TextBox x:Name="AddressBarTextBox" VerticalContentAlignment="Center"
                     Text="{Binding ActiveTab.AddressBarDisplayText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewMouseLeftButtonDown="OnAddressBarPreviewMouseLeftButtonDown"
                     TextChanged="OnAddressBarTextBoxTextChanged"
                     GotKeyboardFocus="OnAddressBarGotKeyboardFocus"
                     LostKeyboardFocus="OnAddressBarLostKeyboardFocus">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ActiveTab.NavigateCommand}" />
                </TextBox.InputBindings>
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontSize" Value="13" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Theme.AddressBarSize}" Value="Small">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="FontSize" Value="11" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Theme.AddressBarSize}" Value="Large">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="FontSize" Value="16" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <!-- The tab strip lives in a separate top-level window (TabSidebarWindow)
             that MainWindow positions/sizes to track its own bounds, so it can
             visually render on top of WebView2's native surface (see the comment
             in TabSidebarWindow.xaml for why a separate window, not an in-window
             overlay, was needed for that). This content Grid's left Margin
             reserves exactly the sidebar's *docked* width (collapsed, or pinned-
             expanded) so the page sits flush next to it in both docked states;
             MainWindow animates that Margin only when IsSidebarPinned toggles.
             A temporary hover-expand (not pinned) leaves this Margin alone, so
             the sidebar floats over the page instead of shoving it aside. -->
        <Grid Grid.Row="1" x:Name="ContentHost" Margin="52,0,0,0">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:BrowserTabView Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="2" x:Name="AddressBarBottomSlot" Padding="6"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0" />
    </Grid>

    <!--
      Cursor trail: fading dots follow the mouse over the app's own WPF chrome
      (toolbar, tab strip, title bar). WebView2 hosts the actual page content
      in a separate native child window, so mouse moves over a page itself
      never reach WPF's routed events — the trail is chrome-only by nature.
    -->
    <Canvas x:Name="CursorTrailCanvas" IsHitTestVisible="False" />
    </Grid>
</Window>
