<Window x:Class="Navigatueur.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Navigatueur.App.Shell"
        xmlns:views="clr-namespace:Navigatueur.App.Views"
        Title="{Binding WindowTitle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        MinWidth="520" MinHeight="360"
        Height="800" Width="1280">
    <WindowChrome.WindowChrome>
        <!-- No caption area at all: the page reaches the top edge. Dragging and
             the window buttons live in the toolbar (see WindowFrameController). -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!--
      One window, two layers:
        ContentHost   the page (one WebView2 per live tab), full size;
        OverlayLayer  the toolbar, tab column and loading line, each in a
                      child window that can sit above WebView2 (see
                      Shell/OverlayHost). ImmersiveShell positions all of them.
    -->
    <Grid x:Name="RootGrid">
        <Grid x:Name="ContentHost">
            <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:BrowserTabView Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Canvas x:Name="OverlayLayer">
            <shell:OverlayHost x:Name="SidebarHost" Visibility="Collapsed" />
            <shell:OverlayHost x:Name="ToolbarHost" Visibility="Collapsed" />
            <shell:OverlayHost x:Name="LoadingHost" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
