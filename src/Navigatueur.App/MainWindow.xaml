<Window x:Class="Navigatueur.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Navigatueur.App.Views"
        xmlns:models="clr-namespace:Navigatueur.App.Models"
        xmlns:vm="clr-namespace:Navigatueur.App.ViewModels"
        Title="Navigatueur"
        Background="{DynamicResource ChromeBackgroundBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        Height="800" Width="1280"
        PreviewMouseMove="OnWindowMouseMoveForTrail">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="CaptionIcon" TargetType="Path" BasedOn="{StaticResource VectorIcon}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="StrokeThickness" Value="1.6" />
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Chrome background image (if the user picked one) + a semi-transparent wash in the theme
             background color on top, so the toolbar/tab strip stay readable over any photo. -->
        <Image Source="{Binding Theme.ChromeBackgroundImagePath, Converter={StaticResource PathToImageSourceConverter}}"
               Stretch="UniformToFill" />
        <Border Background="{DynamicResource ChromeBackgroundBrush}" Opacity="0.55" />

        <!-- The current site's declared theme-color, faded top-to-gray — transparent (no-op) when
             the site doesn't declare one, or a custom background image is set. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <MultiBinding Converter="{StaticResource SiteAccentGradientConverter}">
                    <Binding Path="ActiveTab.SiteAccentColorHex" />
                    <Binding Path="Theme.ChromeBackgroundImagePath" />
                </MultiBinding>
            </Border.Background>
        </Border>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar, replacing the native white caption so it matches the app's own theme. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="🧭" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Navigatueur" FontSize="12" Opacity="0.85"
                               Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Réduire">
                        <Path Data="{StaticResource IconMinimize}" Style="{StaticResource CaptionIcon}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick" ToolTip="Agrandir/Restaurer">
                        <Path Style="{StaticResource CaptionIcon}">
                            <Path.Data>
                                <Binding Path="WindowState" RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{StaticResource WindowStateToIconConverter}" />
                            </Path.Data>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnCloseClick" ToolTip="Fermer">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource CaptionIcon}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Padding="6" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,8,0">
                    <Button Width="32" Command="{Binding ActiveTab.GoBackCommand}" ToolTip="Précédent">
                        <Path Data="{StaticResource IconBack}" Style="{StaticResource VectorIcon}" />
                    </Button>
                    <Button Width="32" Margin="4,0,0,0" Command="{Binding ActiveTab.GoForwardCommand}" ToolTip="Suivant">
                        <Path Data="{StaticResource IconForward}" Style="{StaticResource VectorIcon}" />
                    </Button>
                    <Button Width="32" Margin="4,0,0,0" Command="{Binding ActiveTab.ReloadCommand}" ToolTip="Actualiser">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource VectorIcon}" />
                    </Button>
                    <Button Width="32" Margin="4,0,0,0" Command="{Binding ActiveTab.TogglePictureInPictureCommand}" ToolTip="Picture-in-Picture">
                        <Path Data="{StaticResource IconPip}" Style="{StaticResource VectorIcon}" />
                    </Button>
                </StackPanel>
                <Button x:Name="DownloadsButton" Width="32" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnToggleDownloadsClick" ToolTip="Téléchargements">
                    <Grid>
                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource VectorIcon}" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                 Visibility="{Binding Downloads.HasActiveDownloads, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}" Placement="Bottom" StaysOpen="False">
                    <Border Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8" MinWidth="260" MaxHeight="320">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Downloads.Downloads}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,8">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ChromeTextBrush}" FontSize="12" />
                                            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                         Margin="0,4,0,2" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}"
                                                           Foreground="{DynamicResource ChromeTextBrush}" Opacity="0.6" FontSize="10" />
                                                <Button DockPanel.Dock="Right" Content="Ouvrir le dossier" FontSize="10" Padding="4,0"
                                                        Command="{Binding OpenFolderCommand}" HorizontalContentAlignment="Right" />
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
                <Button Width="32" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnToggleMusicOverlayClick" ToolTip="Contrôleur musique">
                    <Path Data="{StaticResource IconMusic}" Style="{StaticResource VectorIcon}" />
                </Button>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,4" Click="OnUpdateClick"
                        Background="{DynamicResource AccentBrush}"
                        Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Mise à jour" Foreground="White" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Width="32" DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding ToggleSidebarPinnedCommand}" ToolTip="Épingler la colonne des onglets grande ouverte">
                    <Path Data="{StaticResource IconPanelLeft}">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarPinned}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Width="32" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnOpenExtensionsClick" ToolTip="Extensions">
                    <Path Data="{StaticResource IconPuzzle}" Style="{StaticResource VectorIcon}" />
                </Button>
                <Button Width="32" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnOpenMoreMenuClick" ToolTip="Plus d'outils">
                    <Path Data="{StaticResource IconMoreVertical}" Style="{StaticResource VectorIcon}" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Historique" Click="OnOpenHistoryClick" />
                            <MenuItem Header="Téléchargements" Click="OnToggleDownloadsClick" />
                            <MenuItem Header="Enregistrer sous..." Click="OnSaveAsClick" />
                            <MenuItem Header="Traduire la page" Click="OnTranslatePageClick" />
                            <MenuItem Header="Rechercher dans la page" InputGestureText="Ctrl+F" Click="OnFindInPageClick" />
                            <Separator />
                            <MenuItem Header="Zoom +" Command="{Binding ActiveTab.ZoomInCommand}" />
                            <MenuItem Header="Zoom -" Command="{Binding ActiveTab.ZoomOutCommand}" />
                            <MenuItem Header="Réinitialiser le zoom" Command="{Binding ActiveTab.ResetZoomCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Width="32" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnOpenSettingsClick" ToolTip="Paramètres">
                    <Path Data="{StaticResource IconSettings}" Style="{StaticResource VectorIcon}" />
                </Button>
                <Button Width="32" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnOpenPrivateWindowClick" ToolTip="Nouvelle fenêtre de navigation privée">
                    <Path Data="{StaticResource IconPrivate}" Style="{StaticResource VectorIcon}" />
                </Button>
                <Button Width="32" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnOpenSavedGroupsClick" ToolTip="Groupes enregistrés">
                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource VectorIcon}" />
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding SavedGroupMenuItems}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Header}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,4" CornerRadius="4" Background="{DynamicResource SurfaceBrush}">
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding MemoryMonitor.UsedMegabytes, StringFormat='{}{0} Mo'}"
                               Foreground="{Binding MemoryMonitor.UsedMegabytes, Converter={StaticResource RamUsageToBrushConverter}}" />
                </Border>
                <Border x:Name="AddressBarTopSlot">
                    <TextBox x:Name="AddressBarTextBox" VerticalContentAlignment="Center"
                             Text="{Binding ActiveTab.AddressBarDisplayText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseLeftButtonDown="OnAddressBarPreviewMouseLeftButtonDown">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ActiveTab.NavigateCommand}" />
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="FontSize" Value="13" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Theme.AddressBarSize}" Value="Small">
                                        <Setter Property="Padding" Value="6,2" />
                                        <Setter Property="FontSize" Value="11" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Theme.AddressBarSize}" Value="Large">
                                        <Setter Property="Padding" Value="12,8" />
                                        <Setter Property="FontSize" Value="16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TabColumnDefinition" Width="52" MinWidth="52" MaxWidth="400" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
              Vertical tab strip: compact by default, expands on hover unless pinned
              (Zen-browser-style). Driven by a geometric position check in the
              Window-level PreviewMouseMove handler (OnWindowMouseMoveForSidebarHover)
              rather than this element's own MouseEnter/Leave — element-level hit-testing
              proved unreliable here (see git history), and the Window already has a
              PreviewMouseMove hook for the cursor trail that reliably fires across the
              whole WPF chrome area.
            -->
            <Border x:Name="TabColumnHost" Grid.Column="0" Background="Transparent">
                <DockPanel>
                <Border x:Name="AddressBarSidebarSlot" DockPanel.Dock="Top" Margin="4,4,4,2" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding TabStripItems}">
                        <ItemsControl.Resources>

                            <DataTemplate DataType="{x:Type models:TabGroup}">
                                <Button Margin="4,2" Padding="0" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ToggleGroupCollapsedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu ItemsSource="{Binding ContextMenuItems}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding Header}" />
                                                    <Setter Property="Command" Value="{Binding Command}" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border Padding="8,6" CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <Border x:Name="GroupHoverOverlay" CornerRadius="4" Opacity="0" IsHitTestVisible="False"
                                                        Background="{DynamicResource ChromeBorderBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="GroupHoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                                 To="0.5" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="GroupHoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,6,0" StrokeThickness="1.8">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                                    <Setter Property="Data" Value="{StaticResource IconFolder}" />
                                                    <Setter Property="Stroke" Value="{Binding ColorHex}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                                            <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                       Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="Collapsed" VerticalContentAlignment="Center"
                                                     PreviewMouseLeftButtonDown="OnGroupNameEditPreviewMouseDown"
                                                     KeyDown="OnGroupNameEditKeyDown" LostFocus="OnGroupNameEditLostFocus"
                                                     IsVisibleChanged="OnGroupNameEditIsVisibleChanged">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                                <Button Padding="0" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AllowDrop="True"
                                        RenderTransformOrigin="0.5,0.5"
                                        PreviewMouseLeftButtonDown="OnTabPreviewMouseLeftButtonDown"
                                        PreviewMouseMove="OnTabPreviewMouseMove"
                                        Drop="OnTabDrop">
                                    <Button.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform Y="-6" />
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.15" />
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].Y"
                                                                     From="-6" To="0" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Button.Triggers>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Margin" Value="4,2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                                                    <Setter Property="Margin" Value="20,2,4,2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Margin" Value="4,1" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX"
                                                                                 To="1.03" Duration="0:0:0.12">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY"
                                                                                 To="1.03" Duration="0:0:0.12">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX"
                                                                                 To="1" Duration="0:0:0.15" />
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY"
                                                                                 To="1" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu ItemsSource="{Binding ContextMenuItems}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding Header}" />
                                                    <Setter Property="Command" Value="{Binding Command}" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border Padding="8,6" CornerRadius="4"
                                                        Background="{Binding IsActive, Converter={StaticResource ActiveTabBackgroundConverter}}">
                                                    <ContentPresenter />
                                                </Border>
                                                <Border x:Name="TabHoverOverlay" CornerRadius="4" Opacity="0" IsHitTestVisible="False"
                                                        Background="{DynamicResource ChromeBorderBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="TabHoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                                 To="0.5" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="TabHoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Data="{StaticResource IconPin}"
                                              Width="12" Height="12" Margin="0,0,4,0">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Button DockPanel.Dock="Right" Width="20" Height="20" Padding="0"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIcon}" Width="10" Height="10" />
                                        </Button>
                                        <Button DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="0,0,2,0"
                                                Command="{Binding ToggleMuteCommand}" ToolTip="Couper/réactiver le son">
                                            <Path Width="13" Height="13">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                                        <Setter Property="Data" Value="{StaticResource IconVolume}" />
                                                        <Setter Property="Opacity" Value="0.5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconMute}" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>
                                        <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Favicon}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                                   Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>

                        </ItemsControl.Resources>
                    </ItemsControl>
                    <Button Margin="4,4,4,6" Padding="8,8" HorizontalContentAlignment="Left"
                            Command="{Binding NewTabCommand}" ToolTip="Nouvel onglet">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource VectorIcon}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Nouvel onglet" Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource ChromeBorderBrush}" />

            <!-- Content area: each BrowserTabView creates/disposes its own WebView2 based on IsSuspended; only the active one is visible. -->
            <Grid Grid.Column="2">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:BrowserTabView Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Border Grid.Row="3" x:Name="AddressBarBottomSlot" Padding="6"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0" />
    </Grid>

    <!--
      Cursor trail: fading dots follow the mouse over the app's own WPF chrome
      (toolbar, tab strip, title bar). WebView2 hosts the actual page content
      in a separate native child window, so mouse moves over a page itself
      never reach WPF's routed events — the trail is chrome-only by nature.
    -->
    <Canvas x:Name="CursorTrailCanvas" IsHitTestVisible="False" />
    </Grid>
</Window>
