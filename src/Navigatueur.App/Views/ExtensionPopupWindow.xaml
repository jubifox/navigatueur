<Window x:Class="Navigatueur.App.Views.ExtensionPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Extension" Width="380" Height="540" MinWidth="240" MinHeight="200"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ChromeBackgroundBrush}">
    <!--
      A real extension's own popup UI (settings, per-site toggles, stats —
      whatever shows up when you click its toolbar icon in a real browser).
      WebView2 has no extension toolbar of its own to click, so this window
      is the only way to reach that UI at all: it navigates a plain WebView2
      straight to the extension's chrome-extension://{id}/{popup page} URL,
      using the same profile/environment the extension is actually installed
      into (see ExtensionService.OpenPopup) so its storage/background script
      state is the real, live one — not a fresh, disconnected instance.
    -->
    <wv2:WebView2 x:Name="PopupWebView" />
</Window>
