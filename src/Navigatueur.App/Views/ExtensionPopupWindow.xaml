<Window x:Class="Navigatueur.App.Views.ExtensionPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Extension" Width="380" Height="560" MinWidth="240" MinHeight="200"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}">
    <!--
      A real extension's own popup (settings, per-site switches, stats — what
      clicking its icon shows in other browsers). WebView2 has no extension
      toolbar, so Navigatueur opens it here, under its toolbar button, and
      closes it when the user clicks elsewhere, like a browser popup. It runs
      in the same profile as the tabs, so the extension's state is the live one.
      No AllowsTransparency: a WebView2 doesn't render in a layered window.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <wv2:WebView2 x:Name="PopupWebView" />
    </Border>
</Window>
