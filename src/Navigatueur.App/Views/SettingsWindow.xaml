<Window x:Class="Navigatueur.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Width="380" Height="620"
        Background="{DynamicResource ChromeBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <TextBlock Text="Thème" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Sombre" Padding="14,6" Margin="0,0,8,0" Click="OnDarkClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ThemeMode}" Value="Dark">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Clair" Padding="14,6" Click="OnLightClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ThemeMode}" Value="Light">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <TextBlock Text="Couleur d'accent" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Width="28" Height="28" Margin="0,0,6,0" Background="#4C8DFF" Click="OnAccentSwatchClick" Tag="#4C8DFF" ToolTip="Bleu" />
            <Button Width="28" Height="28" Margin="0,0,6,0" Background="#4FE0A0" Click="OnAccentSwatchClick" Tag="#4FE0A0" ToolTip="Vert" />
            <Button Width="28" Height="28" Margin="0,0,6,0" Background="#E0A52A" Click="OnAccentSwatchClick" Tag="#E0A52A" ToolTip="Ambre" />
            <Button Width="28" Height="28" Margin="0,0,6,0" Background="#E04F4F" Click="OnAccentSwatchClick" Tag="#E04F4F" ToolTip="Rouge" />
            <Button Width="28" Height="28" Margin="0,0,6,0" Background="#B14FE0" Click="OnAccentSwatchClick" Tag="#B14FE0" ToolTip="Violet" />
            <Button Width="28" Height="28" Background="#4FD1E0" Click="OnAccentSwatchClick" Tag="#4FD1E0" ToolTip="Cyan" />
        </StackPanel>

        <TextBlock Text="Ou choisis une teinte" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Rectangle Height="6" RadiusX="3" RadiusY="3" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.167" />
                            <GradientStop Color="#00FF00" Offset="0.333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.667" />
                            <GradientStop Color="#FF00FF" Offset="0.833" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Slider x:Name="HueSlider" Minimum="0" Maximum="359" Background="Transparent"
                        ValueChanged="OnHueChanged" />
            </Grid>
            <Border Grid.Column="1" Width="28" Height="28" Margin="10,0,0,0" CornerRadius="4"
                    BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush x:Name="HuePreviewBrush" Color="#4C8DFF" />
                </Border.Background>
            </Border>
        </Grid>

        <TextBlock Text="Fond du navigateur" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Choisir une image..." Padding="10,6" Margin="0,0,8,0" Click="OnChooseChromeBackgroundClick" />
            <Button Content="Réinitialiser" Padding="10,6" Click="OnResetChromeBackgroundClick" />
        </StackPanel>

        <TextBlock Text="Fond de la page nouvel onglet" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Choisir une image..." Padding="10,6" Margin="0,0,8,0" Click="OnChooseNewTabBackgroundClick" />
            <Button Content="Réinitialiser" Padding="10,6" Click="OnResetNewTabBackgroundClick" />
        </StackPanel>
        <TextBlock Text="Les onglets déjà ouverts reprennent le nouveau fond au prochain rechargement."
                   Foreground="{DynamicResource ChromeTextBrush}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20" />

        <TextBlock Text="Moteur de recherche" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}" Margin="0,0,0,8" />
        <ItemsControl x:Name="EngineList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Padding="10,6" Margin="0,0,8,8" Click="OnEngineClick" Tag="{Binding Id}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ChromeTextBrush}" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Mises à jour" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}" Margin="0,20,0,8" />
        <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource ChromeTextBrush}" Opacity="0.7"
                   FontSize="11" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="CheckForUpdatesButton" Content="Vérifier les mises à jour" Padding="10,6"
                    Margin="0,0,8,0" Click="OnCheckForUpdatesClick" />
            <Button x:Name="InstallUpdateButton" Content="Installer la mise à jour" Padding="10,6"
                    Click="OnInstallUpdateClick" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource ChromeTextBrush}" Opacity="0.7"
                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
    </ScrollViewer>
</Window>
