<Window x:Class="Navigatueur.App.Views.TabSidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Navigatueur.App.Models"
        xmlns:vm="clr-namespace:Navigatueur.App.ViewModels"
        Title="" ShowInTaskbar="False" ShowActivated="False" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource ChromeBackgroundBrush}"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <!--
      This is a genuinely separate top-level window, not an in-window overlay —
      that's the whole point. WebView2 hosts page content in its own native child
      HWND, and WPF's "airspace" limitation means no WPF element, regardless of
      Z-order, can ever visually render on top of a native child window living in
      the SAME window. A separate window doesn't have that limitation: as an
      owned window it Z-orders above its owner (MainWindow) including all of the
      owner's child HWNDs, so the tab strip actually appears over the active page
      when expanded, instead of being silently hidden behind it.
    -->
    <Border BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
            <Border x:Name="AddressBarSidebarSlot" DockPanel.Dock="Top" Margin="4,4,4,2" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding TabStripItems}">
                    <ItemsControl.Resources>

                        <DataTemplate DataType="{x:Type models:TabGroup}">
                            <Button Margin="4,2" Padding="0" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.ToggleGroupCollapsedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding ContextMenuItems}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="Command" Value="{Binding Command}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="GroupHoverOverlay" CornerRadius="4" Opacity="0" IsHitTestVisible="False"
                                                    Background="{DynamicResource ChromeBorderBrush}" />
                                            <Border Padding="8,6" CornerRadius="4">
                                                <ContentPresenter />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="GroupHoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                             To="0.5" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="GroupHoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.18" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,6,0" StrokeThickness="1.8">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                                <Setter Property="Data" Value="{StaticResource IconFolder}" />
                                                <Setter Property="Stroke" Value="{Binding ColorHex}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                                        <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                   Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="Collapsed" VerticalContentAlignment="Center"
                                                 PreviewMouseLeftButtonDown="OnGroupNameEditPreviewMouseDown"
                                                 KeyDown="OnGroupNameEditKeyDown" LostFocus="OnGroupNameEditLostFocus"
                                                 IsVisibleChanged="OnGroupNameEditIsVisibleChanged">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DockPanel>
                            </Button>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                            <Button Padding="0" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AllowDrop="True"
                                    RenderTransformOrigin="0.5,0.5"
                                    PreviewMouseLeftButtonDown="OnTabPreviewMouseLeftButtonDown"
                                    PreviewMouseMove="OnTabPreviewMouseMove"
                                    Drop="OnTabDrop">
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                        <TranslateTransform Y="-6" />
                                    </TransformGroup>
                                </Button.RenderTransform>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].Y"
                                                                 From="-6" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="4,2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                                                <Setter Property="Margin" Value="20,2,4,2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Margin" Value="4,1" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX"
                                                                             To="1.03" Duration="0:0:0.12">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY"
                                                                             To="1.03" Duration="0:0:0.12">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX"
                                                                             To="1" Duration="0:0:0.15" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY"
                                                                             To="1" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding ContextMenuItems}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="Command" Value="{Binding Command}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="TabHoverOverlay" CornerRadius="4" Opacity="0" IsHitTestVisible="False"
                                                    Background="{DynamicResource ChromeBorderBrush}" />
                                            <Border Padding="8,6" CornerRadius="4"
                                                    Background="{Binding IsActive, Converter={StaticResource ActiveTabBackgroundConverter}}">
                                                <ContentPresenter />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="TabHoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                             To="0.5" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="TabHoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.18" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconPin}"
                                          Width="12" Height="12" Margin="0,0,4,0">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Button DockPanel.Dock="Right" Width="20" Height="20" Padding="0"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIcon}" Width="10" Height="10" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="0,0,2,0"
                                            Command="{Binding ToggleMuteCommand}" ToolTip="Couper/réactiver le son">
                                        <Path Width="13" Height="13">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                                    <Setter Property="Data" Value="{StaticResource IconVolume}" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource IconMute}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>
                                    <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Favicon}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                               Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Button>
                        </DataTemplate>

                    </ItemsControl.Resources>
                </ItemsControl>
                <Button Margin="4,4,4,6" Padding="8,8" HorizontalContentAlignment="Left"
                        Command="{Binding NewTabCommand}" ToolTip="Nouvel onglet">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource VectorIcon}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="Nouvel onglet" Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
