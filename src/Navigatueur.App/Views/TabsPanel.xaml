<UserControl x:Class="Navigatueur.App.Views.TabsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Navigatueur.App.Models"
             xmlns:vm="clr-namespace:Navigatueur.App.ViewModels"
             xmlns:views="clr-namespace:Navigatueur.App.Views"
             x:Name="PanelRoot"
             FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
             Foreground="{DynamicResource TextBrush}">
    <!--
      The tab column. Like the toolbar it lives in its own child window over
      the page (Shell/OverlayHost); the transparent strip on its inner side is
      room for the shadow when it floats.
    -->
    <UserControl.Resources>
        <!-- A tab row: quiet at rest, soft fill on hover, filled + accent bar when active. -->
        <Style x:Key="TabRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Fill" CornerRadius="8" Background="Transparent" />
                            <Border x:Name="DropBefore" Height="2" VerticalAlignment="Top" Margin="6,-2,6,0" CornerRadius="1"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <Border x:Name="DropAfter" Height="2" VerticalAlignment="Bottom" Margin="6,0,6,-2" CornerRadius="1"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <Border x:Name="DropInto" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
                            </DataTrigger>
                            <Trigger Property="views:TabsPanel.DropPosition" Value="Before">
                                <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="views:TabsPanel.DropPosition" Value="After">
                                <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="views:TabsPanel.DropPosition" Value="Into">
                                <Setter TargetName="DropInto" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                    <Setter Property="Margin" Value="22,1,8,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shown on hover (or when active) only, so a long list stays calm. -->
        <Style x:Key="RowHoverOnly" TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
            <Button Style="{StaticResource TabRow}"
                    Command="{Binding DataContext.ActivateTabCommand, ElementName=PanelRoot}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Title}"
                    Click="OnTabRowClick"
                    PreviewMouseLeftButtonDown="OnTabPreviewMouseLeftButtonDown"
                    PreviewMouseMove="OnTabPreviewMouseMove"
                    MouseUp="OnTabMouseUp"
                    PreviewKeyDown="OnTabPreviewKeyDown"
                    DragOver="OnTabDragOver" DragLeave="OnTabDragLeave" Drop="OnTabDrop">
                <Button.ContextMenu>
                    <ContextMenu ItemsSource="{Binding ContextMenuItems}">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active marker on the column's outer edge. -->
                    <Border Grid.ColumnSpan="4" Width="3" Height="16" CornerRadius="1.5"
                            Margin="{Binding IndicatorMargin, ElementName=PanelRoot}"
                            HorizontalAlignment="{Binding IndicatorAlignment, ElementName=PanelRoot}"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                    <!-- Favicon, a globe without one, a spinner while loading. -->
                    <Grid Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center">
                        <Image Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}" />
                        <Path Data="{StaticResource IconGlobe}" Style="{StaticResource VectorIcon}" Width="14" Height="14"
                              Stroke="{DynamicResource TextTertiaryBrush}">
                            <Path.Visibility>
                                <MultiBinding Converter="{StaticResource FaviconFallbackVisibility}">
                                    <Binding Path="Favicon" />
                                    <Binding Path="IsLoading" />
                                </MultiBinding>
                            </Path.Visibility>
                        </Path>
                        <Path Data="{StaticResource IconSpinner}" Width="14" Height="14"
                              Stroke="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Spin">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Spin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>

                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Sound: always visible while playing or muted, so the noisy tab is easy to find. -->
                    <Button Grid.Column="2" Command="{Binding ToggleMuteCommand}" ToolTip="Couper / réactiver le son" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Width="13" Height="13">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                    <Setter Property="Data" Value="{StaticResource IconVolume}" />
                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconMute}" />
                                            <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <Grid Grid.Column="3" Width="26">
                        <Path Data="{StaticResource IconPin}" Style="{StaticResource VectorIcon}" Width="12" Height="12"
                              Stroke="{DynamicResource TextTertiaryBrush}"
                              Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource RowHoverOnly}" ToolTip="Fermer l'onglet (Ctrl+W)"
                                Command="{Binding DataContext.CloseTabCommand, ElementName=PanelRoot}" CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIcon}" Width="11" Height="11" />
                        </Button>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:TabGroup}">
            <Grid>
                <Button x:Name="GroupHeader" Style="{StaticResource TabRow}" Margin="8,6,8,1"
                        Command="{Binding DataContext.ToggleGroupCollapsedCommand, ElementName=PanelRoot}"
                        CommandParameter="{Binding}"
                        ToolTip="Glisser pour déplacer le groupe"
                        PreviewMouseLeftButtonDown="OnGroupPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnGroupPreviewMouseMove"
                        DragOver="OnGroupDragOver" DragLeave="OnTabDragLeave" Drop="OnGroupDrop">
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding ContextMenuItems}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Header}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <DockPanel Height="30" Margin="10,0,8,0">
                        <Path DockPanel.Dock="Left" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Margin="0,0,8,0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                    <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-90" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <!-- Folder icon in the group's color, with the chosen glyph (play, note…) inside. -->
                        <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Fill="{Binding ColorHex}" Opacity="0.22" />
                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource VectorIcon}" Width="20" Height="20"
                                  StrokeThickness="1.6" Stroke="{Binding ColorHex}" />
                            <Path Data="{Binding Icon, Converter={StaticResource GroupGlyph}}" Style="{StaticResource VectorIcon}"
                                  Width="11" Height="9" StrokeThickness="1.5" Stroke="{Binding ColorHex}" Margin="0,3,0,0" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,2"
                                     Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                     PreviewMouseLeftButtonDown="OnGroupNameEditPreviewMouseDown"
                                     KeyDown="OnGroupNameEditKeyDown" LostFocus="OnGroupNameEditLostFocus"
                                     IsVisibleChanged="OnGroupNameEditIsVisibleChanged" />
                        </Grid>
                    </DockPanel>
                </Button>

                <!-- Icon picker ("Changer l'icône…" in the group's menu). -->
                <Popup IsOpen="{Binding IsPickingIcon, Mode=TwoWay}" PlacementTarget="{Binding ElementName=GroupHeader}"
                       Placement="Bottom" HorizontalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource PopupCard}" Width="244">
                        <StackPanel>
                            <TextBlock Text="Icône du groupe" FontWeight="SemiBold" Margin="6,2,6,8" />
                            <ItemsControl ItemsSource="{x:Static models:TabGroup.IconChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="44" Height="40" Margin="1" ToolTip="{Binding Label}"
                                                Command="{Binding DataContext.ChooseIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}">
                                            <Grid Width="26" Height="26">
                                                <Path Data="{StaticResource IconFolder}" Stretch="Uniform"
                                                      Fill="{Binding DataContext.ColorHex, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Opacity="0.22" />
                                                <Path Data="{StaticResource IconFolder}" Style="{StaticResource VectorIcon}" Width="26" Height="26"
                                                      StrokeThickness="1.6" Stroke="{Binding DataContext.ColorHex, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <Path Data="{Binding Key, Converter={StaticResource GroupGlyph}}" Style="{StaticResource VectorIcon}"
                                                      Width="14" Height="12" StrokeThickness="1.6" Margin="0,4,0,0"
                                                      Stroke="{Binding DataContext.ColorHex, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Dossier simple, sans icône" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="1,8,1,2"
                                    HorizontalAlignment="Stretch" FontSize="12"
                                    Command="{Binding ChooseIconCommand}" CommandParameter="" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Body" HorizontalAlignment="Left" Width="280"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
                <Image Source="{Binding Theme.ChromeBackgroundImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                       Stretch="UniformToFill" Opacity="0.35" IsHitTestVisible="False" />

                <DockPanel>
                    <!-- Header -->
                    <DockPanel DockPanel.Dock="Top" Height="48" Margin="16,0,10,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding NewTabCommand}" ToolTip="Nouvel onglet (Ctrl+T)">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource VectorIcon}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="sidebar.toggleDock" Click="OnCommandClick"
                                ToolTip="Garder la colonne affichée / masquée automatiquement">
                            <Path Data="{StaticResource IconPin}" Width="14" Height="14">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                        <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarDocked}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Onglets" FontFamily="{DynamicResource UiDisplayFontFamily}" FontWeight="SemiBold" FontSize="14" />
                            <Border Margin="8,0,0,0" CornerRadius="6" Padding="6,1" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TabCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,10">
                        <Button x:Name="SavedGroupsButton" HorizontalContentAlignment="Left" Padding="10,7" Click="OnSavedGroupsClick"
                                Visibility="{Binding HasSavedGroups, Converter={StaticResource BoolToVis}}">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SavedGroupsMenu" ItemsSource="{Binding SavedGroupMenuItems}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Style="{StaticResource VectorIcon}" Width="14" Height="14" Margin="0,0,10,0"
                                      Stroke="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Groupes enregistrés" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalContentAlignment="Stretch" Padding="10,7" Command="{Binding NewTabCommand}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+T" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <Path DockPanel.Dock="Left" Data="{StaticResource IconPlus}" Style="{StaticResource VectorIcon}" Width="14" Height="14" Margin="0,0,10,0"
                                      Stroke="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Nouvel onglet" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Tabs -->
                    <ScrollViewer x:Name="TabsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TabsList" ItemsSource="{Binding TabStripItems}" Margin="0,0,0,6"
                                      KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Once" />
                    </ScrollViewer>
                </DockPanel>

                <!-- Drag the inner edge to resize the column. -->
                <Thumb x:Name="ResizeGrip" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                       DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Grid>
</UserControl>
