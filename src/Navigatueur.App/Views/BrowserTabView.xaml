<UserControl x:Class="Navigatueur.App.Views.BrowserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="ContentHost" Background="White" />

        <Border x:Name="PermissionBar" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1"
                VerticalAlignment="Top" Padding="12,8" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="PermissionText" DockPanel.Dock="Left" MaxWidth="500"
                           Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <CheckBox x:Name="PermissionRememberCheckBox" Content="Se souvenir" IsChecked="True"
                              Foreground="{DynamicResource ChromeTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Bloquer" Padding="10,4" Margin="0,0,6,0" Click="OnPermissionBlockClick" />
                    <Button Content="Autoriser" Padding="10,4" Foreground="White"
                            Background="{DynamicResource AccentBrush}" Click="OnPermissionAllowClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Trail dots for the current page's content, positioned from coordinates the page itself
             reports via a JS mousemove bridge — WebView2's own content is a separate native child
             window, so WPF never sees mouse moves over it directly. See EnsureLoadedAsync. -->
        <Canvas x:Name="CursorTrailOverlay" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</UserControl>
