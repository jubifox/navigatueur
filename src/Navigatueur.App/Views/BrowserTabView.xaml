<UserControl x:Class="Navigatueur.App.Views.BrowserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Nothing here may overlap the WebView2: it's a native child window, and
      any WPF element drawn in the same place ends up hidden behind it. The
      permission prompt therefore takes its own row above the page (it used to
      float over the page, where it could never actually be seen).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="PermissionBar" Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconLock}" Style="{StaticResource VectorIcon}" Width="14" Height="14" Margin="0,0,10,0"
                          Stroke="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="PermissionText" MaxWidth="560" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="PermissionRememberCheckBox" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Se souvenir" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </CheckBox>
                    <Button Content="Bloquer" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnPermissionBlockClick" />
                    <Button Content="Autoriser" Style="{StaticResource PrimaryButton}" Click="OnPermissionAllowClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" />

        <!-- Shown instead of the page when the web engine can't start (e.g. no WebView2 runtime). -->
        <Border x:Name="EngineErrorPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource WindowBackgroundBrush}">
            <StackPanel MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Le moteur Web n'a pas pu démarrer" FontSize="20" FontWeight="SemiBold"
                           FontFamily="{DynamicResource UiDisplayFontFamily}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
                <TextBlock x:Name="EngineErrorText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18" />
                <Button Content="Réessayer" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnRetryEngineClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
