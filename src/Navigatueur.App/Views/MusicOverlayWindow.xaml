<Window x:Class="Navigatueur.App.Views.MusicOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navigatueur — Musique"
        Width="360" Height="168"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Topmost="True" ShowInTaskbar="False"
        Background="Transparent"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10">
        <Grid>
            <!-- Border.CornerRadius only rounds its own fill, it doesn't clip children — clip explicitly. -->
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,360,168" RadiusX="10" RadiusY="10" />
            </Grid.Clip>

            <!-- Base wash: the cover's dominant color fills the whole overlay -->
            <Border Background="{Binding BackgroundBrush}" />

            <!-- Cover art: right-aligned, full height, flush with the overlay's own edges — its
                 corners are rounded by the shared Grid.Clip above, not a clip of its own. -->
            <Border Width="160" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Grid>
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                    <Rectangle Fill="{Binding FadeBrush}" />
                </Grid>
            </Border>

            <!-- Wash fade over the rest of the overlay, blending into the cover -->
            <Rectangle Fill="{Binding FadeBrush}" IsHitTestVisible="False" />

            <Button Content="✕" Style="{StaticResource IconButton}" Foreground="{Binding ForegroundBrush}"
                    Click="OnCloseClick" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" />

            <StackPanel VerticalAlignment="Bottom" Margin="14,0,160,12">
                <TextBlock Text="{Binding Title}" Foreground="{Binding ForegroundBrush}" FontWeight="Bold" FontSize="16"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" Foreground="{Binding ForegroundBrush}" Opacity="0.8" FontSize="14"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Album}" Foreground="{Binding ForegroundBrush}" Opacity="0.65" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                           Visibility="{Binding HasAlbum, Converter={StaticResource BoolToVis}}" />

                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                             Background="#33000000" Foreground="{Binding ForegroundBrush}" BorderThickness="0" Margin="0,0,0,7" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="⏮" Style="{StaticResource IconButton}" Foreground="{Binding ForegroundBrush}" Command="{Binding PreviousCommand}" />
                    <Button Content="⏪" Style="{StaticResource IconButton}" Foreground="{Binding ForegroundBrush}" Command="{Binding SeekBackCommand}" />
                    <Button Foreground="{Binding ForegroundBrush}" Command="{Binding PlayPauseCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="▶" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="⏸" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⏩" Style="{StaticResource IconButton}" Foreground="{Binding ForegroundBrush}" Command="{Binding SeekForwardCommand}" />
                    <Button Content="⏭" Style="{StaticResource IconButton}" Foreground="{Binding ForegroundBrush}" Command="{Binding NextCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
