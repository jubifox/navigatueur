<Window x:Class="Navigatueur.App.Views.PrivateBrowsingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Navigatueur.App.Views"
        xmlns:vm="clr-namespace:Navigatueur.App.ViewModels"
        Title="Navigatueur — Navigation privée"
        Background="#1A1424"
        WindowStyle="None" ResizeMode="CanResize"
        Height="800" Width="1200">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="PrivateSurfaceBrush" Color="#2A2138" />
        <SolidColorBrush x:Key="PrivateBorderBrush" Color="#3D3350" />
        <SolidColorBrush x:Key="PrivateTextBrush" Color="#EAE4F5" />
        <SolidColorBrush x:Key="PrivateAccentBrush" Color="#8B5CF6" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrivateTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrivateBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PrivateSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrivateTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrivateTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrivateBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="PrivateIcon" TargetType="Path" BasedOn="{StaticResource VectorIcon}">
            <Setter Property="Stroke" Value="{StaticResource PrivateTextBrush}" />
        </Style>
        <Style x:Key="PrivateCaptionIcon" TargetType="Path" BasedOn="{StaticResource PrivateIcon}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="StrokeThickness" Value="1.6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource PrivateSurfaceBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="🕶" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Navigation privée" FontSize="12" Opacity="0.85"
                               Foreground="{StaticResource PrivateTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Réduire">
                        <Path Data="{StaticResource IconMinimize}" Style="{StaticResource PrivateCaptionIcon}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick" ToolTip="Agrandir/Restaurer">
                        <Path Style="{StaticResource PrivateCaptionIcon}">
                            <Path.Data>
                                <Binding Path="WindowState" RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{StaticResource WindowStateToIconConverter}" />
                            </Path.Data>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnCloseClick" ToolTip="Fermer">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource PrivateCaptionIcon}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Padding="6" BorderBrush="{StaticResource PrivateBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,8,0">
                    <Button Width="32" Command="{Binding ActiveTab.GoBackCommand}" ToolTip="Précédent">
                        <Path Data="{StaticResource IconBack}" Style="{StaticResource PrivateIcon}" />
                    </Button>
                    <Button Width="32" Margin="4,0,0,0" Command="{Binding ActiveTab.GoForwardCommand}" ToolTip="Suivant">
                        <Path Data="{StaticResource IconForward}" Style="{StaticResource PrivateIcon}" />
                    </Button>
                    <Button Width="32" Margin="4,0,0,0" Command="{Binding ActiveTab.ReloadCommand}" ToolTip="Actualiser">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource PrivateIcon}" />
                    </Button>
                </StackPanel>
                <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,4" CornerRadius="4" Background="{StaticResource PrivateSurfaceBrush}">
                    <TextBlock Text="🕶 Rien n'est enregistré" Foreground="{StaticResource PrivateTextBrush}" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
                </Border>
                <TextBox VerticalContentAlignment="Center" Padding="8,4"
                         Text="{Binding ActiveTab.AddressBarText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ActiveTab.NavigateCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" MaxWidth="360" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vertical tab strip -->
            <Border Grid.Column="0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Margin="4,4,4,6" Padding="8,8" HorizontalContentAlignment="Left"
                            Command="{Binding NewTabCommand}" ToolTip="Nouvel onglet privé">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource PrivateIcon}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Nouvel onglet" Foreground="{StaticResource PrivateTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                                    <Button Margin="4,2" Padding="0" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Padding="8,6" CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource PrivateSurfaceBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Width="20" Height="20" Padding="0"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconClose}" Style="{StaticResource PrivateIcon}" Width="10" Height="10" />
                                            </Button>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource PrivateTextBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource PrivateBorderBrush}" />

            <Grid Grid.Column="2">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:BrowserTabView Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
