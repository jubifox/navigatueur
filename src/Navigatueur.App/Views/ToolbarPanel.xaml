<UserControl x:Class="Navigatueur.App.Views.ToolbarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Navigatueur.App.Shell"
             FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
             Foreground="{DynamicResource TextBrush}">
    <!--
      The top bar. Hosted in its own child window (see Shell/OverlayHost) so it
      can float over the page. Its root is transparent: in floating mode the
      area below Body is room for the shadow, drawn over the page.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Body" VerticalAlignment="Top" Height="48"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnBodyMouseLeftButtonDown">
            <Grid ClipToBounds="True">
                <!-- Background image: sized to the whole window and placed by PlaceWallpaper, so the
                     toolbar and the tab column each show their part of one picture, lined up with the page's. -->
                <Canvas x:Name="WallpaperLayer" IsHitTestVisible="False">
                    <Rectangle x:Name="Wallpaper" Opacity="0.35">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding Theme.EffectiveChromeBackgroundImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                        Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                </Canvas>
                <!-- The site's own theme-color, as a faint tint — the toolbar takes on the page's identity. -->
                <Border IsHitTestVisible="False" Opacity="0.55">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource SiteAccentGradientConverter}">
                            <Binding Path="ActiveTab.SiteAccentColorHex" />
                            <Binding Path="Theme.EffectiveChromeBackgroundImagePath" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <Grid Margin="8,0,6,0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Navigation cluster -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Focusable="False" x:Name="TabsToggleButton" Style="{StaticResource BarIconButton}" Width="40" Padding="8,8,0,8" Margin="-8,0,0,0"
                                Tag="sidebar.toggleDock" Click="OnCommandClick"
                                ToolTip="Afficher ou masquer la colonne d'onglets">
                            <Path x:Name="TabsToggleIcon">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                        <Setter Property="Data" Value="{StaticResource IconPanelLeft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarOnRight}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconPanelRight}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarDocked}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource PanelBorderBrush}" />
                        <Button Focusable="False" Style="{StaticResource BarIconButton}" Command="{Binding ActiveTab.GoBackCommand}" ToolTip="Précédent (Alt+←)">
                            <Path Data="{StaticResource IconBack}" Style="{StaticResource VectorIcon}" />
                        </Button>
                        <Button Focusable="False" Style="{StaticResource BarIconButton}" Command="{Binding ActiveTab.GoForwardCommand}" ToolTip="Suivant (Alt+→)">
                            <Path Data="{StaticResource IconForward}" Style="{StaticResource VectorIcon}" />
                        </Button>
                        <Grid>
                            <Button Focusable="False" Style="{StaticResource BarIconButton}" Command="{Binding ActiveTab.ReloadCommand}" ToolTip="Actualiser (Ctrl+R)"
                                    Visibility="{Binding ActiveTab.IsLoading, Converter={StaticResource InverseBoolToVis}}">
                                <Path Data="{StaticResource IconRefresh}" Style="{StaticResource VectorIcon}" Width="15" Height="15" />
                            </Button>
                            <Button Focusable="False" Style="{StaticResource BarIconButton}" Command="{Binding ActiveTab.StopCommand}" ToolTip="Arrêter le chargement"
                                    Visibility="{Binding ActiveTab.IsLoading, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIcon}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Address field -->
                    <Border x:Name="AddressField" Grid.Column="1" Height="34" MaxWidth="760" Margin="16,0"
                            MouseLeftButtonDown="OnAddressFieldMouseLeftButtonDown"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="10"
                            Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="Transparent">
                        <DockPanel Margin="10,0,4,0">
                            <!-- Private-window badge -->
                            <Border DockPanel.Dock="Left" CornerRadius="6" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPrivate}" Style="{StaticResource VectorIcon}" Width="13" Height="13"
                                          Stroke="{DynamicResource AccentBrush}" Margin="0,0,5,0" />
                                    <TextBlock Text="Privé" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- Site identity: lock for https, globe otherwise, magnifier on the new tab page -->
                            <Path x:Name="SiteIcon" DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                        <Setter Property="Data" Value="{StaticResource IconGlobe}" />
                                        <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab.IsSecure}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconLock}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.IsInternalPage}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconSearch}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Button Focusable="False" x:Name="StarButton" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Width="28" Height="26"
                                    Tag="bookmark.toggle" Click="OnCommandClick" ToolTip="Ajouter aux favoris (Ctrl+D)">
                                <Path Data="{StaticResource IconStar}" Width="15" Height="15">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                            <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveTab.IsBookmarked}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Grid>
                                <TextBlock x:Name="AddressPlaceholder" Text="Rechercher ou saisir une adresse"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Margin="2,0,0,0" />
                                <TextBox x:Name="AddressBox" Style="{StaticResource BareTextBox}" FontSize="13.5"
                                         GotKeyboardFocus="OnAddressGotKeyboardFocus"
                                         LostKeyboardFocus="OnAddressLostKeyboardFocus"
                                         PreviewMouseLeftButtonDown="OnAddressPreviewMouseLeftButtonDown"
                                         PreviewKeyDown="OnAddressPreviewKeyDown"
                                         TextChanged="OnAddressTextChanged" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Tools cluster -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Focusable="False" x:Name="DownloadsButton" Style="{StaticResource BarIconButton}" Click="OnDownloadsClick" ToolTip="Téléchargements (Ctrl+J)"
                                Visibility="{Binding Downloads.HasDownloads, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Path Data="{StaticResource IconDownload}" Style="{StaticResource VectorIcon}" />
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                         Visibility="{Binding Downloads.HasActiveDownloads, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                        <Button Focusable="False" x:Name="BookmarksButton" Style="{StaticResource BarIconButton}" Click="OnBookmarksClick" ToolTip="Favoris">
                            <Path Data="{StaticResource IconBookmark}" Style="{StaticResource VectorIcon}" />
                        </Button>
                        <Button Focusable="False" x:Name="ExtensionsButton" Style="{StaticResource BarIconButton}" Click="OnExtensionsClick" ToolTip="Extensions"
                                Visibility="{Binding IsPrivate, Converter={StaticResource InverseBoolToVis}}">
                            <Path Data="{StaticResource IconPuzzle}" Style="{StaticResource VectorIcon}" />
                        </Button>
                        <Button Focusable="False" x:Name="MenuButton" Style="{StaticResource BarIconButton}" Click="OnMenuClick" ToolTip="Paramètres et outils">
                            <Button.ContextMenu>
                        <ContextMenu x:Name="MainMenu" Opened="OnMainMenuOpened" Closed="OnMainMenuClosed">
                            <MenuItem Header="Nouvel onglet" Tag="tab.new" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconPlus}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Nouvelle fenêtre" Tag="window.new" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconWindow}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Nouvelle fenêtre privée" Tag="window.private" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconPrivate}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Rouvrir l'onglet fermé" Tag="tab.reopen" Click="OnCommandClick"
                                      IsEnabled="{Binding TabManager.CanReopenClosedTab}">
                                <MenuItem.Icon><Path Data="{StaticResource IconRefresh}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Historique" Tag="history.open" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconHistory}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Téléchargements" Tag="downloads.open" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconDownload}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Extensions" Tag="extensions.open" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconPuzzle}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Zoom">
                                <MenuItem.Icon><Path Data="{StaticResource IconZoomIn}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                                <MenuItem Header="Agrandir" Tag="zoom.in" Click="OnCommandClick" InputGestureText="Ctrl++" />
                                <MenuItem Header="Réduire" Tag="zoom.out" Click="OnCommandClick" InputGestureText="Ctrl+-" />
                                <MenuItem Header="Taille réelle" Tag="zoom.reset" Click="OnCommandClick" InputGestureText="Ctrl+0" />
                            </MenuItem>
                            <MenuItem Header="Rechercher dans la page" Tag="page.find" Click="OnCommandClick" InputGestureText="Ctrl+F">
                                <MenuItem.Icon><Path Data="{StaticResource IconSearch}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Traduire la page" Tag="page.translate" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconTranslate}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Enregistrer sous…" Tag="page.saveAs" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconSave}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding ActiveTab.ForceDarkMenuHeader}" Tag="page.forceDark" Click="OnCommandClick"
                                      Visibility="{Binding ActiveTab.CanForceDark, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <MenuItem.Icon><Path Data="{StaticResource IconMoon}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Picture-in-Picture" Tag="page.pip" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconPip}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Mini-lecteur musique" Tag="music.toggle" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconMusic}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Plein écran" Tag="view.fullscreen" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconFullscreen}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Paramètres" Tag="settings.open" Click="OnCommandClick">
                                <MenuItem.Icon><Path Data="{StaticResource IconSettings}" Style="{StaticResource MenuIcon}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Tag="update.install" Click="OnCommandClick"
                                      Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <MenuItem.Header>
                                    <TextBlock Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                               Text="{Binding Update.LatestVersion, StringFormat='Installer la mise à jour {0}'}" />
                                </MenuItem.Header>
                                <MenuItem.Icon><Path Data="{StaticResource IconDownload}" Style="{StaticResource MenuIcon}" Stroke="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem IsEnabled="False">
                                <MenuItem.Header>
                                    <TextBlock Text="{Binding MemoryMonitor.UsedMegabytes, StringFormat='Mémoire utilisée : {0} Mo'}" FontSize="12"
                                               Foreground="{Binding MemoryMonitor.UsedMegabytes, Converter={StaticResource RamUsageToBrushConverter}}" />
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                            </Button.ContextMenu>
                            <Grid>
                                <Path Data="{StaticResource IconMoreHorizontal}" Style="{StaticResource VectorIcon}" StrokeThickness="2.4" />
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                         Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Window buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Width="1" Height="18" Margin="0,0,6,0" Background="{DynamicResource PanelBorderBrush}" />
                        <Button Focusable="False" Style="{StaticResource BarCaptionButton}" Tag="window.minimize" Click="OnCommandClick" ToolTip="Réduire">
                            <Path Data="{StaticResource IconMinimize}" Style="{StaticResource VectorIcon}" Width="12" Height="12" />
                        </Button>
                        <Button Focusable="False" Style="{StaticResource BarCaptionButton}" Tag="window.maximize" Click="OnCommandClick" ToolTip="Agrandir / Restaurer">
                            <Path Width="12" Height="12">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                        <Setter Property="Data" Value="{StaticResource IconMaximize}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconRestore}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconExitFullscreen}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Focusable="False" x:Name="CloseButton" Style="{StaticResource BarCloseButton}" Width="42" Padding="0,8,6,8" Margin="0,0,-6,0"
                                Tag="window.close" Click="OnCommandClick" ToolTip="Fermer">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIcon}" Width="12" Height="12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Loading indicator: a short accent streak sweeping along the bottom edge. -->
                <Canvas x:Name="ProgressTrack" Height="2" VerticalAlignment="Bottom" ClipToBounds="True" IsHitTestVisible="False">
                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab.IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>
                    <Rectangle x:Name="ProgressStreak" Height="2" Width="220" Fill="{DynamicResource AccentBrush}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="Transparent" />
                                <GradientStop Offset="0.5" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ProgressOffset" X="-220" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Grid>
        </Border>

        <!-- Address suggestions (history + favorites) -->
        <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=AddressField}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="True" Focusable="False" VerticalOffset="-6" HorizontalOffset="-12"
               PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}" Width="{Binding ActualWidth, ElementName=AddressField}">
                <ListBox x:Name="SuggestionsList" BorderThickness="0" Background="Transparent" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnSuggestionClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="7" Padding="10,7" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                            <Setter Property="Data" Value="{StaticResource IconHistory}" />
                                            <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Bookmark">
                                                    <Setter Property="Data" Value="{StaticResource IconStar}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayUrl}" Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="12" Margin="12,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- Favorites -->
        <Popup x:Name="BookmarksPopup" PlacementTarget="{Binding ElementName=BookmarksButton}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" HorizontalOffset="-300" VerticalOffset="-12">
            <Border Style="{StaticResource PopupCard}" Width="360">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,4,2,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12"
                                Tag="bookmark.toggle" Click="OnCommandClick">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Ajouter cette page" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveTab.IsBookmarked}" Value="True">
                                                    <Setter Property="Text" Value="Retirer cette page" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <TextBlock Text="Favoris" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="BookmarksEmptyText" Margin="8,4,8,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               Text="Aucun favori pour l'instant. Cliquez sur l'étoile de la barre d'adresse ou appuyez sur Ctrl+D." />
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Bookmarks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,1"
                                            Click="OnBookmarkItemClick" MouseUp="OnBookmarkItemMouseUp" ToolTip="{Binding Url}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Click="OnBookmarkRemoveClick"
                                                    ToolTip="Retirer des favoris">
                                                <Button.Visibility>
                                                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=Button}" Converter="{StaticResource BoolToVis}" />
                                                </Button.Visibility>
                                                <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIcon}" Width="11" Height="11" />
                                            </Button>
                                            <Path DockPanel.Dock="Left" Data="{StaticResource IconGlobe}" Style="{StaticResource VectorIcon}"
                                                  Width="14" Height="14" Margin="0,0,10,0" Stroke="{DynamicResource TextTertiaryBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- Extensions: the core ones first. A click opens the extension's own menu (or its settings). -->
        <Popup x:Name="ExtensionsPopup" PlacementTarget="{Binding ElementName=ExtensionsButton}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" HorizontalOffset="-300" VerticalOffset="-12">
            <Border Style="{StaticResource PopupCard}" Width="340">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Extensions" FontWeight="SemiBold" FontSize="14" Margin="6,4,6,8" />
                    <Button DockPanel.Dock="Bottom" Content="Gérer les extensions…" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="2,8,2,2"
                            HorizontalAlignment="Stretch" FontSize="12" Tag="extensions.open" Click="OnCommandClick" />
                    <TextBlock DockPanel.Dock="Top" Margin="8,4,8,10" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Les extensions intégrées s'installent dès qu'un premier onglet est chargé.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Extensions.Extensions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Extensions.Extensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,1" Click="OnExtensionItemClick"
                                            ToolTip="{Binding Description}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Activer / désactiver" />
                                            <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Image Source="{Binding IconPath}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Path Data="{StaticResource IconPuzzle}" Width="16" Height="16">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource VectorIcon}">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding ActionHint}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Text" Value="Désactivée" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- Downloads -->
        <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" HorizontalOffset="-260" VerticalOffset="-12">
            <Border Style="{StaticResource PopupCard}" Width="320">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Téléchargements" FontWeight="SemiBold" FontSize="14" Margin="6,4,6,8" />
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Downloads.Downloads}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,7" Margin="0,1" Background="{DynamicResource SurfaceBrush}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Afficher" FontSize="11.5" Padding="8,2"
                                                        Command="{Binding OpenFolderCommand}" />
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,4" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>

</UserControl>
