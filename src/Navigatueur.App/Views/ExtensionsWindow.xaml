<Window x:Class="Navigatueur.App.Views.ExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extensions" Width="520" Height="660" MinWidth="420" MinHeight="400"
        Background="{DynamicResource PanelBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Header doubles as the window's drag area -->
            <DockPanel DockPanel.Dock="Top" Height="56" Margin="22,0,10,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick" ToolTip="Fermer"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIcon}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconPuzzle}" Style="{StaticResource VectorIcon}" Width="18" Height="18" Margin="0,0,10,0" />
                    <TextBlock Text="Extensions" FontFamily="{DynamicResource UiDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Margin="22,0,22,12">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,12"
                           Text="Navigatueur charge de vraies extensions Chrome (uBlock Origin, SponsorBlock…). Ajoutez un dossier d'extension « non empaqueté » contenant un manifest.json." />
                <Button Content="Ajouter une extension…" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnAddExtensionClick" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,18,18">
                <StackPanel>
                    <TextBlock Text="RECOMMANDÉES" Style="{StaticResource SectionLabel}" Margin="2,6,0,8" />
                    <ItemsControl ItemsSource="{Binding RecommendedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding InstallCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Setter Property="Content" Value="Installer" />
                                                    <Setter Property="Padding" Value="12,6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                            <Setter Property="Content" Value="Installation…" />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Content" Value="Installée" />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="INSTALLÉES" Style="{StaticResource SectionLabel}" Margin="2,14,0,8" />
                    <ItemsControl ItemsSource="{Binding Extensions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center" ToolTip="Activer / désactiver" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Width="28" Height="28" Margin="6,0,0,0"
                                                Command="{Binding RemoveCommand}" ToolTip="Supprimer">
                                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource VectorIcon}" Width="14" Height="14" />
                                        </Button>
                                        <!-- Extensions with a manifest-declared popup get "Ouvrir": WebView2 has no
                                             extension toolbar, so this is the only way to reach that UI. -->
                                        <Button DockPanel.Dock="Right" Content="Ouvrir" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"
                                                Command="{Binding OpenPopupCommand}"
                                                Visibility="{Binding HasPopup, Converter={StaticResource BoolToVis}}" />
                                        <!-- Extensions added before v0.17.0 don't know their folder: ask for it once. -->
                                        <Button DockPanel.Dock="Right" Content="Localiser…" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"
                                                Click="OnLocateExtensionFolderClick"
                                                Visibility="{Binding NeedsFolderLocation, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
