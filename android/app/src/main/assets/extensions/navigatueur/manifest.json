{
  "manifest_version": 2,
  "name": "Navigatueur",
  "version": "1.0",
  "description": "Liaison entre les pages et Navigatueur : icône et couleur du site, vidéo en image dans l'image.",
  "browser_specific_settings": {
    "gecko": { "id": "navigatueur@navigatueur.app" }
  },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
