<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_tab"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_tab"
        android:shortcutShortLabel="@string/shortcut_new_tab">
        <intent
            android:action="com.navigatueur.mobile.NEW_TAB"
            android:targetPackage="com.navigatueur.mobile"
            android:targetClass="com.navigatueur.mobile.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="private_tab"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_private"
        android:shortcutShortLabel="@string/shortcut_private_tab">
        <intent
            android:action="com.navigatueur.mobile.NEW_TAB"
            android:targetPackage="com.navigatueur.mobile"
            android:targetClass="com.navigatueur.mobile.MainActivity">
            <extra android:name="private" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
