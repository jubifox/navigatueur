{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC for the chrome and for the app's own pages (settings, history, new tab, warning), which load inside tab webviews.",
  "windows": ["main"],
  "webviews": ["chrome", "tab-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-create-webview",
    "core:event:default",
    "dialog:default",
    "opener:default"
  ]
}
